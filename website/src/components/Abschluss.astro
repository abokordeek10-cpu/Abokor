---
// Abschluss jeder Seite: gelbes Band mit Slogan und Button.
import Icon from './Icon.astro';
import { CTA_LINK, CTA_TEXT } from '../config';

interface Props {
  titel?: string;
  text?: string;
}
const {
  titel = 'Bereit für weniger Büroarbeit?',
  text = 'Lass uns gemeinsam herausfinden, welche Aufgaben in deinem Betrieb sinnvoll automatisiert werden können.',
} = Astro.props;
// Ältere Seiten übergeben Titel mit gelber Hervorhebung. Auf Gelb wird daraus eine Unterstreichung.
---

<section class="abschnitt abschnitt--dunkel abschluss">
  <div class="container">
    <div class="abschluss__band" data-reveal>
      <div>
        <h2 set:html={titel} />
        <p>{text}</p>
      </div>
      <a href={CTA_LINK} class="btn btn--dunkel btn--gross btn--block-mobil">
        {CTA_TEXT}
        <Icon name="pfeil" />
      </a>
    </div>
  </div>
</section>

<style>
  .abschluss__band {
    display: grid;
    gap: 24px;
    align-items: center;
    background: var(--gelb);
    color: var(--text);
    border-radius: 18px;
    padding: clamp(28px, 5vw, 52px);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 26px), calc(100% - 26px) 100%, 0 100%);
  }
  @media (min-width: 900px) {
    .abschluss__band {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }
  }
  .abschluss__band h2 {
    font-size: clamp(1.8rem, 4.4vw, 2.9rem);
    margin-bottom: 10px;
  }
  .abschluss__band h2 :global(.gelb) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
  }
  .abschluss__band p {
    margin: 0;
    max-width: 38rem;
    font-weight: 500;
  }
  .btn--dunkel {
    background: var(--dunkel);
    color: var(--text-hell);
  }
  .btn--dunkel:hover {
    background: #16294a;
    transform: translateY(-2px);
  }
</style>
