---
// Einstieg der Startseite: Slogan links, Produkt-Übersicht (Beispieldaten) rechts.
import Icon from './Icon.astro';
import { CTA_LINK, CTA_TEXT } from '../config';

const weg = [
  { icon: 'anfrage', text: 'Anfrage' },
  { icon: 'filter', text: 'Vorsortiert' },
  { icon: 'kalender', text: 'Termin' },
  { icon: 'angebot', text: 'Angebot' },
] as const;

const zeilen = [
  { titel: 'Badsanierung', ort: 'Mannheim', status: 'Erste Antwort gesendet', art: 'ok' },
  { titel: 'Heizung fällt aus', ort: 'Viernheim', status: 'Dringend', art: 'eilt' },
  { titel: 'Dachreparatur', ort: 'Weinheim', status: 'Terminvorschlag', art: 'ok' },
];

const merkmale = [
  { icon: 'schild', text: 'Server in Deutschland' },
  { icon: 'haken', text: 'Du gibst frei' },
  { icon: 'uhr', text: 'Monatlich kündbar' },
  { icon: 'werkzeug', text: 'Für alle Gewerke' },
] as const;
---

<section class="einstieg blaupause" aria-labelledby="einstieg-titel">
  <div class="einstieg__licht" aria-hidden="true"></div>
  <div class="container einstieg__raster">
    <div class="einstieg__text">
      <p class="mono einstieg__dach">Abora Automation · KI-Automatisierung für das Handwerk</p>
      <h1 id="einstieg-titel">
        Du machst das<br />
        <span class="einstieg__marke">Handwerk.</span><br />
        Wir machen den Rest.
      </h1>
      <p class="einstieg__unter">Weniger Büroarbeit. Mehr Zeit für Aufträge.</p>
      <p class="einstieg__satz">
        Wir bauen KI-Automatisierungen für Handwerksbetriebe in ganz Deutschland: von der Kundenanfrage über den Termin bis
        zum Nachfassen von Angeboten.
      </p>
      <div class="einstieg__aktionen">
        <a href={CTA_LINK} class="btn btn--gelb btn--gross btn--block-mobil" data-cta-haupt>
          {CTA_TEXT}
          <Icon name="pfeil" />
        </a>
        <a href="#demo" class="btn btn--rahmen btn--gross btn--block-mobil einstieg__zweit">Live-Demo ansehen</a>
      </div>
      <ul class="einstieg__merkmale">
        {merkmale.map((m) => (
          <li>
            <Icon name={m.icon} />
            {m.text}
          </li>
        ))}
      </ul>
    </div>

    <div class="pult" data-pult>
      <div class="pult__kopf">
        <span class="pult__punkte" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="pult__name">Abora · Übersicht</span>
        <span class="etikett etikett--gelb">Beispieldaten</span>
      </div>
      <p class="pult__status"><i aria-hidden="true"></i> Automatisierung aktiv</p>
      <ol class="pult__weg" aria-label="Beispielablauf: Anfrage, vorsortiert, Termin, Angebot">
        {weg.map((w, i) => (
          <li style={`--i:${i}`}>
            <span class="pult__knoten"><Icon name={w.icon} /></span>
            <span>{w.text}</span>
          </li>
        ))}
      </ol>
      <ul class="pult__liste">
        {zeilen.map((z) => (
          <li>
            <span class="pult__zeile-text">
              <strong>{z.titel}</strong>
              <small>{z.ort}</small>
            </span>
            <span class:list={['pult__marke', `pult__marke--${z.art}`]}>{z.status}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .einstieg {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(112px, 16vw, 168px) 0 clamp(56px, 8vw, 104px);
  }
  .einstieg__licht {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 55% 60% at 80% 35%, rgba(255, 200, 61, 0.11), transparent 70%),
      radial-gradient(ellipse 60% 70% at 10% 0%, rgba(60, 110, 190, 0.22), transparent 70%),
      linear-gradient(180deg, transparent 70%, var(--dunkel) 100%);
  }
  .einstieg__raster {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .einstieg__raster {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }
  .einstieg__dach {
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5.2vw, 3.35rem);
    margin-bottom: 18px;
    text-wrap: normal;
    line-height: 1.1;
  }
  .einstieg__marke {
    display: inline-block;
    background: var(--gelb);
    color: var(--text);
    padding: 0 0.14em 0.04em;
    margin: 0.04em 0 0.04em -0.06em;
    border-radius: 6px;
    transform: rotate(-1.2deg);
  }
  .einstieg__unter {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .einstieg__satz {
    color: var(--text-gedaempft);
    max-width: 34rem;
    font-size: 1.06rem;
    margin-bottom: 28px;
  }
  .einstieg__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .einstieg__aktionen .btn {
    padding-inline: 22px;
  }
  .einstieg__merkmale {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-gedaempft);
  }
  .einstieg__merkmale li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .einstieg__merkmale :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--gelb);
  }

  /* Produkt-Übersicht */
  .pult {
    position: relative;
    background: linear-gradient(180deg, rgba(20, 36, 62, 0.92), rgba(9, 18, 33, 0.96));
    border: 1px solid var(--gelb-linie);
    border-radius: 16px;
    padding: 18px;
    box-shadow:
      0 40px 80px -40px rgba(0, 0, 0, 0.8),
      0 0 0 6px rgba(255, 200, 61, 0.04);
  }
  .pult__kopf {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--linie-dunkel);
  }
  .pult__punkte {
    display: inline-flex;
    gap: 5px;
  }
  .pult__punkte i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(140, 175, 230, 0.35);
  }
  .pult__name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-gedaempft);
    margin-right: auto;
  }
  .pult__status {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 16px 0 14px;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .pult__status i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #46d58a;
    box-shadow: 0 0 0 4px rgba(70, 213, 138, 0.18);
  }
  .pult__weg {
    list-style: none;
    margin: 0 0 16px;
    padding: 16px 8px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px dashed var(--linie-dunkel);
    border-radius: 12px;
    background: rgba(6, 13, 24, 0.5);
  }
  .pult__weg li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-gedaempft);
    text-align: center;
  }
  .pult__weg li + li::before {
    content: '';
    position: absolute;
    top: 21px;
    left: calc(-50% + 26px);
    right: calc(50% + 26px);
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--gelb) 0 6px, transparent 6px 11px);
    opacity: 0.7;
  }
  .pult__knoten {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    border: 1.5px solid var(--gelb-linie);
    color: var(--gelb);
    background: rgba(255, 200, 61, 0.07);
  }
  .pult__knoten :global(svg) {
    width: 21px;
    height: 21px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pult__knoten {
      animation: knoten 6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 1.2s);
    }
    @keyframes knoten {
      0%,
      14%,
      100% {
        background: rgba(255, 200, 61, 0.07);
        color: var(--gelb);
      }
      5% {
        background: var(--gelb);
        color: var(--text);
      }
    }
  }
  .pult__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pult__liste li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 13px;
    border-radius: 10px;
    border: 1px solid var(--linie-dunkel);
    background: rgba(16, 30, 52, 0.6);
  }
  .pult__zeile-text {
    display: grid;
    line-height: 1.25;
    min-width: 0;
  }
  .pult__zeile-text strong {
    font-size: 0.92rem;
  }
  .pult__zeile-text small {
    color: var(--text-gedaempft);
    font-size: 0.78rem;
  }
  .pult__marke {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 6px;
    white-space: nowrap;
    color: #7fe3ae;
    background: rgba(70, 213, 138, 0.12);
  }
  .pult__marke--eilt {
    color: var(--gelb);
    background: rgba(255, 200, 61, 0.14);
  }
</style>
