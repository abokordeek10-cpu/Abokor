---
// Logo von Abora Automation (helle Variante für dunkle Hintergründe).
interface Props {
  groesse?: 'normal' | 'gross';
}
const { groesse = 'normal' } = Astro.props;
---

<img
  src="/logo/abora-quer-hell.webp"
  alt="Abora Automation"
  width="604"
  height="150"
  class:list={['logo', `logo--${groesse}`]}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    height: 40px;
    width: auto;
  }
  .logo--gross {
    height: 56px;
  }
  @media (min-width: 900px) {
    .logo {
      height: 46px;
    }
    .logo--gross {
      height: 64px;
    }
  }
</style>
