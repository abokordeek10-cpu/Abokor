---
// Wiederkehrendes Element: Handy-Benachrichtigung im Look des Reels.
interface Props {
  titel: string;
  text?: string;
  zeit?: string;
  class?: string;
  style?: string;
}
const { titel, text, zeit = 'jetzt', class: klasse, style } = Astro.props;
---

<div class:list={['bn', klasse]} style={style}>
  <span class="bn__icon" aria-hidden="true">A</span>
  <div class="bn__inhalt">
    <div class="bn__zeile">
      <span class="bn__app">Abora</span>
      <span class="bn__zeit">{zeit}</span>
    </div>
    <strong class="bn__titel">{titel}</strong>
    {text && <span class="bn__text">{text}</span>}
  </div>
</div>

<style>
  .bn {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    width: 100%;
    max-width: 340px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.97);
    color: var(--text);
    border-radius: 18px;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.15);
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .bn__icon {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--gelb);
    color: var(--dunkel);
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 1.15rem;
  }
  .bn__inhalt {
    display: grid;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .bn__zeile {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #6b6f76;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .bn__titel {
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .bn__text {
    color: #3f444b;
  }
</style>
