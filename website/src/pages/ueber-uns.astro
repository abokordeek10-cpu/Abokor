---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abschluss from '../components/Abschluss.astro';
import Icon from '../components/Icon.astro';
import Vision from '../components/Vision.astro';
import { KONTAKT } from '../config';

const werte = [
  { icon: 'handschlag', titel: 'Ehrlich', text: 'Wir sagen dir, was sich lohnt und was nicht. Auch wenn die Antwort mal „brauchst du nicht“ ist.' },
  { icon: 'chat', titel: 'Verständlich', text: 'Kein Fachchinesisch. Wir erklären alles so, dass es in der Mittagspause verständlich ist.' },
  { icon: 'werkzeug', titel: 'Bodenständig', text: 'Keine Spielereien. Nur das, was dir im Alltag wirklich Arbeit abnimmt.' },
];
---

<Basis
  titel="Über uns"
  beschreibung="Abora Automation aus Viernheim: Gründer Abokor Deek Osman nimmt Handwerksbetrieben Büroarbeit ab. Wo Abora heute steht und wohin es gehen soll."
>
  <Seitenkopf
    dachzeile="Über uns"
    titel='Ein Gründer. <span class="gelb">Eine klare Mission.</span>'
    text="Wir wollen Betriebe von wiederkehrender Büroarbeit entlasten. Heute im Handwerk, später auch in anderen Branchen."
  />

  <section class="abschnitt abschnitt--tafel">
    <div class="container geschichte">
      <div data-reveal>
        <p class="dachzeile">Wer dahintersteht</p>
        <h2>Wir stehen am Anfang. Und sagen das offen.</h2>
        <p class="ueber-uns__text">
          Ich bin Abokor aus Viernheim und baue Automatisierungen für Handwerksbetriebe. Handwerker stehen den ganzen Tag
          auf der Baustelle und machen das Büro abends. Genau das will ich ihnen abnehmen.
        </p>
        <p class="ueber-uns__klein">
          Wir haben noch keine zahlenden Kunden. Deshalb findest du hier keine Kundenstimmen und keine großen Versprechen,
          sondern eine Live-Demo, klare Preise und ein faires Angebot für unsere ersten Pilotbetriebe.
        </p>
        <p class="ueber-uns__kontakt">
          <a href={`tel:${KONTAKT.telefonLink}`}>{KONTAKT.telefon}</a><br />
          <a href={`mailto:${KONTAKT.email}`}>{KONTAKT.email}</a>
        </p>
      </div>
      <ul class="stand" data-reveal style="--delay:.1s">
        <li class="karte"><span class="mono">HEUTE</span><strong>1 Gründer</strong><span>{KONTAKT.inhaber}, dein fester Ansprechpartner</span></li>
        <li class="karte"><span class="mono">ANGEBOT</span><strong>6 Bausteine</strong><span>Von der Anfrage bis zur Rechnung</span></li>
        <li class="karte"><span class="mono">GESUCHT</span><strong>3 Pilotbetriebe</strong><span>Einrichtung zum halben Preis</span></li>
      </ul>
    </div>
  </section>

  <section class="abschnitt abschnitt--dunkel">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Wohin wir wollen</p>
        <h2>Vom Handwerk <span class="gelb">bis zur Industrie.</span></h2>
        <p class="einleitung">Wir bauen Abora mit einer langen Sicht. Aber Schritt für Schritt, und zuerst für die Betriebe, die wir am besten verstehen.</p>
      </div>
      <Vision />
    </div>
  </section>

  <section class="abschnitt abschnitt--tafel">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Wie wir arbeiten</p>
        <h2>Drei Dinge, auf die du dich verlassen kannst</h2>
      </div>
      <div class="raster raster--3">
        {
          werte.map((w, i) => (
            <article class="karte" data-reveal style={`--delay:${i * 0.08}s`}>
              <div class="icon-kreis">
                <Icon name={w.icon} />
              </div>
              <h3>{w.titel}</h3>
              <p style="margin:0;color:var(--text-gedaempft)">{w.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Abschluss
    titel="Lern uns kennen. Ganz unverbindlich."
    text="Im kostenlosen Büro-Check merkst du schnell, ob wir zusammenpassen."
  />
</Basis>

<style>
  .geschichte {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 960px) {
    .geschichte {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 64px;
      align-items: center;
    }
  }
  .ueber-uns__text {
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    line-height: 1.55;
    font-weight: 500;
  }
  .ueber-uns__klein {
    color: var(--text-gedaempft);
  }
  .ueber-uns__kontakt a {
    font-weight: 700;
    text-decoration-color: var(--gelb);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .stand {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .stand li {
    display: grid;
    gap: 2px;
    padding: 18px 20px;
  }
  .stand strong {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .stand li span:last-child {
    color: var(--text-gedaempft);
    font-size: 0.92rem;
  }
</style>
