---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abschluss from '../components/Abschluss.astro';
import Icon from '../components/Icon.astro';
import { KONTAKT } from '../config';

const werte = [
  { icon: 'handschlag', titel: 'Ehrlich', text: 'Wir sagen dir, was sich lohnt und was nicht. Auch wenn die Antwort mal „brauchst du nicht“ ist.' },
  { icon: 'chat', titel: 'Verständlich', text: 'Kein Fachchinesisch. Wir erklären alles so, dass es in der Mittagspause verständlich ist.' },
  { icon: 'werkzeug', titel: 'Bodenständig', text: 'Keine Spielereien. Nur das, was dir im Alltag wirklich Arbeit abnimmt.' },
];
---

<Basis
  titel="Über uns"
  beschreibung="Wer hinter Abora Automation aus Viernheim steht und warum wir Automatisierung speziell für Handwerksbetriebe bauen."
>
  <Seitenkopf
    dachzeile="Über uns"
    titel='Wir bauen die Technik. <span class="gelb">Du bleibst beim Handwerk.</span>'
    text="Abora Automation sitzt in Viernheim. Wir automatisieren für Handwerksbetriebe alles rund um Anfragen, Termine und Angebote."
  />

  <section class="abschnitt abschnitt--hell">
    <div class="container geschichte">
      <div class="fliesstext" data-reveal>
        <p class="dachzeile">Wer dahintersteht</p>
        <h2>{KONTAKT.inhaber}</h2>
        <p class="ueber-uns__text">
          Ich bin Abokor aus Viernheim und baue Automatisierungen für Handwerksbetriebe. Handwerker stehen den ganzen Tag auf
          der Baustelle und machen das Büro abends. Genau das will ich ihnen abnehmen.
        </p>
        <p class="ueber-uns__kontakt">
          <a href={`tel:${KONTAKT.telefonLink}`}>{KONTAKT.telefon}</a><br />
          <a href={`mailto:${KONTAKT.email}`}>{KONTAKT.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt--dunkel">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Wie wir arbeiten</p>
        <h2>Drei Dinge, auf die du dich verlassen kannst</h2>
      </div>
      <div class="raster raster--3">
        {
          werte.map((w, i) => (
            <article class="karte" data-reveal style={`--delay:${i * 0.08}s`}>
              <div class="icon-kreis">
                <Icon name={w.icon} />
              </div>
              <h3>{w.titel}</h3>
              <p style="margin:0;color:var(--text-gedaempft)">{w.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Abschluss
    titel='Lern uns kennen. <span class="gelb">Ganz unverbindlich.</span>'
    text="Im kostenlosen Erstgespräch merkst du schnell, ob wir zusammenpassen."
  />
</Basis>

<style>
  .fliesstext h2 {
    margin-top: 0;
  }
  .ueber-uns__text {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.55;
    font-weight: 500;
  }
  .ueber-uns__kontakt a {
    font-weight: 700;
    color: var(--text);
    text-decoration-color: var(--gelb);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
