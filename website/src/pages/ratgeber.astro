---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abschluss from '../components/Abschluss.astro';
import Icon from '../components/Icon.astro';
import { ARTIKEL } from '../artikel';
---

<Basis
  titel="Ratgeber"
  beschreibung="Ratgeber für Handwerksbetriebe: Wie du Anfragen schneller beantwortest, weniger Aufträge verlierst und das Büro in den Griff bekommst."
>
  <Seitenkopf
    dachzeile="Ratgeber"
    titel='Weniger Büro. <span class="gelb">Mehr Aufträge.</span>'
    text="Praktische Tipps für Handwerksbetriebe. Kurz, ehrlich und ohne Fachchinesisch."
  />

  <section class="abschnitt abschnitt--hell">
    <div class="container">
      <div class="artikel-liste">
        {
          ARTIKEL.map((a) => (
            <a href={a.pfad} class="artikel-karte" data-reveal>
              <div class="artikel-karte__bild" aria-hidden="true">
                <Icon name="anfrage" />
              </div>
              <div class="artikel-karte__text">
                <p class="artikel-karte__meta">
                  {a.kategorie} · {a.lesezeit} Min. Lesezeit
                </p>
                <h2>{a.titel}</h2>
                <p>{a.anreisser}</p>
                <span class="artikel-karte__mehr">
                  Weiterlesen <Icon name="pfeil" />
                </span>
              </div>
            </a>
          ))
        }
        <div class="artikel-bald" data-reveal>
          <p><strong>Weitere Artikel folgen.</strong> Du hast eine Frage, über die wir schreiben sollen? Sag's uns im Erstgespräch.</p>
        </div>
      </div>
    </div>
  </section>

  <Abschluss />
</Basis>

<style>
  .artikel-liste {
    display: grid;
    gap: 20px;
  }
  .artikel-karte {
    display: grid;
    background: #fff;
    border: 1px solid var(--linie-hell);
    border-radius: var(--radius-gross);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .artikel-karte:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.35);
  }
  @media (min-width: 800px) {
    .artikel-karte {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .artikel-karte__bild {
    min-height: 200px;
    display: grid;
    place-items: center;
    color: var(--gelb);
    background:
      radial-gradient(ellipse 70% 60% at 70% 20%, rgba(255, 170, 70, 0.2), transparent 70%),
      linear-gradient(160deg, #1b2a3b, var(--dunkel) 60%, var(--dunkel-tief));
  }
  .artikel-karte__bild :global(svg) {
    width: 64px;
    height: 64px;
  }
  .artikel-karte__text {
    padding: 26px 24px;
  }
  .artikel-karte__meta {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blaugrau);
    margin-bottom: 10px;
  }
  .artikel-karte h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .artikel-karte p:not(.artikel-karte__meta) {
    color: var(--text-gedaempft-hell);
  }
  .artikel-karte__mehr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    border-bottom: 2px solid var(--gelb);
  }
  .artikel-karte__mehr :global(svg) {
    width: 18px;
    height: 18px;
  }
  .artikel-bald {
    border: 1px dashed rgba(17, 17, 17, 0.25);
    border-radius: var(--radius-gross);
    padding: 22px 24px;
    color: var(--text-gedaempft-hell);
  }
  .artikel-bald p {
    margin: 0;
  }
</style>
