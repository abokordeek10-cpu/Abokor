---
import Basis from '../layouts/Basis.astro';
import Einstieg from '../components/Einstieg.astro';
import BausteinRaster from '../components/BausteinRaster.astro';
import Pakete from '../components/Pakete.astro';
import Vision from '../components/Vision.astro';
import WhatsAppChat from '../components/WhatsAppChat.astro';
import Rechner from '../components/Rechner.astro';
import AblaufSchritte from '../components/AblaufSchritte.astro';
import FAQ from '../components/FAQ.astro';
import Abschluss from '../components/Abschluss.astro';
import Icon from '../components/Icon.astro';
import { ABLAUF_KURZ } from '../inhalte';
import { CTA_LINK, CTA_TEXT, PREISE, PILOTANGEBOT } from '../config';

const probleme = [
  {
    icon: 'telefon',
    titel: 'Anfragen bleiben liegen',
    text: 'Du stehst auf dem Dach, das Handy klingelt. Abends hast du drei verpasste Anrufe und keine Ahnung, wer was wollte.',
  },
  {
    icon: 'auto',
    titel: 'Fahrten zu Kunden, die nicht passen',
    text: 'Eine Stunde hin und zurück für eine Besichtigung, und dann will der Kunde nur einen Vergleichspreis.',
  },
  {
    icon: 'angebot',
    titel: 'Angebote ohne Antwort',
    text: 'Das Angebot für die Badsanierung ist seit zwei Wochen raus. Gehört hast du nichts. Nachhaken? Keine Zeit.',
  },
  {
    icon: 'mond',
    titel: 'Büro frisst den Feierabend',
    text: 'Rückrufe, Angebote, Rechnungen: Das Büro machst du nach Feierabend, statt bei deiner Familie zu sein.',
  },
] as const;

const fragen = [
  {
    frage: 'Was kostet das?',
    antwort: `<p>Du zahlst einmal für die Einrichtung und danach einen festen Betrag pro Monat für Betrieb, Betreuung, Server- und KI-Kosten. Das Paket „Start“ kostet ${PREISE.start.aufbau} und ${PREISE.start.monat}. Die ersten 3 Pilotbetriebe zahlen für die Einrichtung nur ${PREISE.start.pilot}. ${PREISE.hinweis} <a href="/preise">Alle Pakete ansehen</a></p>`,
  },
  {
    frage: 'Was ist der kostenlose Büro-Check?',
    antwort:
      '<p>Ein Gespräch von etwa 20 Minuten. Wir gehen deine Büro-Woche durch und finden heraus, wo die meiste Zeit draufgeht: Anrufe, Anfragen, Angebote, Termine oder Rechnungen. Dann zeigen wir dir an einem Beispiel aus deinem Gewerk, wie wir genau das automatisieren. Kostenlos und ohne Verpflichtung.</p>',
  },
  {
    frage: 'Was kosten Telefon und WhatsApp?',
    antwort:
      '<p>Telefonnummer, SMS und Gesprächsminuten kosten je nach Nutzung extra. Du hast zwei Möglichkeiten: Die Nummer läuft über uns und wir rechnen die Kosten offen mit ab. Oder du schließt sie auf deinen eigenen Namen ab, zahlst direkt beim Anbieter, und wir verbinden sie nur mit deiner Automatisierung. Was das bei dir ungefähr kostet, rechnen wir im Büro-Check gemeinsam aus.</p>',
  },
  {
    frage: 'Muss ich mich mit Technik auskennen?',
    antwort:
      '<p>Nein. Wir richten alles ein und verbinden es mit dem, was du schon nutzt, zum Beispiel Website, E-Mail und Kalender. Du bekommst eine Einweisung und kannst uns jederzeit anrufen, wenn etwas nicht passt.</p>',
  },
  {
    frage: 'Entscheidet die KI etwas ohne mich?',
    antwort:
      '<p>Nein. Die KI nimmt dir Vorarbeit ab: antworten, nachfragen, sortieren, vorbereiten. Preise, Angebote und Zusagen gibst immer du frei.</p>',
  },
  {
    frage: 'Habt ihr schon Kunden?',
    antwort:
      '<p>Noch nicht. Wir sind neu und sagen das offen. Deshalb gibt es hier keine Kundenstimmen, sondern ein Pilotangebot für die ersten 3 Betriebe und eine Live-Demo, die wir dir im Büro-Check mit deinem Gewerk zeigen.</p>',
  },
  {
    frage: 'Was passiert mit den Daten meiner Kunden?',
    antwort:
      '<p>Wir nutzen sie nur, um deine Automatisierungen zu betreiben. Unser Server steht in Deutschland (Falkenstein). Für die KI-Funktionen setzen wir Claude von Anthropic ein. Vor dem Start schließen wir mit dir einen Vertrag zur Auftragsverarbeitung.</p>',
  },
  {
    frage: 'Wie lange dauert der Aufbau?',
    antwort:
      '<p>Meist 2 bis 4 Wochen. Den genauen Zeitplan bekommst du nach dem Büro-Check.</p>',
  },
  {
    frage: 'Kann ich jederzeit kündigen?',
    antwort: '<p>Die Betreuung ist monatlich kündbar.</p>',
  },
];
---

<Basis
  titel="Startseite"
  beschreibung="Abora Automation: KI-Automatisierung für Handwerksbetriebe in ganz Deutschland. Kundenanfragen beantworten und vorsortieren, Termine organisieren, Angebote nachfassen. Weniger Büroarbeit, mehr Zeit für Aufträge."
>
  <!-- 1. Einstieg -->
  <Einstieg />

  <!-- 2. Problem -->
  <section class="abschnitt abschnitt--tafel" id="problem">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Der Alltag</p>
        <h2>Deine Arbeit findet auf der Baustelle statt. <span class="gelb">Die Büroarbeit wartet trotzdem.</span></h2>
        <p class="einleitung">Kunden schreiben E-Mails, stellen Rückfragen, möchten Termine vereinbaren und warten auf Angebote. Abora verbindet diese Abläufe zu intelligenten Automatisierungen, die zu deinem Betrieb passen. Du behältst die Kontrolle über wichtige Entscheidungen.</p>
      </div>
      <div class="raster raster--4">
        {
          probleme.map((p, i) => (
            <article class="karte problem" data-reveal style={`--delay:${i * 0.08}s`}>
              <div class="icon-kreis"><Icon name={p.icon} /></div>
              <h3>{p.titel}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Lösung: sechs Bausteine -->
  <section class="abschnitt abschnitt--dunkel" id="loesung">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Die Lösung</p>
        <h2>Sechs Bausteine. <span class="gelb">Ein durchgängiger Ablauf.</span></h2>
        <p class="einleitung">Von der ersten Anfrage bis zur Bewertung.</p>
      </div>
      <BausteinRaster />
    </div>
  </section>

  <!-- 4. Demo -->
  <section class="abschnitt abschnitt--tafel" id="demo">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Live-Demo</p>
        <h2>Sieh selbst, <span class="gelb">wie Abora funktioniert.</span></h2>
        <p class="einleitung">Ein beispielhafter Ablauf: Eine Anfrage kommt an, wichtige Informationen werden gesammelt und der Betrieb erhält eine strukturierte Übersicht.</p>
      </div>
      <div class="demo">
        <div class="demo__chat" data-reveal>
          <WhatsAppChat />
        </div>
        <div class="demo__seite">
          <article class="karte uebersicht" data-reveal>
            <div class="uebersicht__kopf">
              <h3>Das landet bei dir</h3>
              <span class="etikett etikett--gelb">Beispieldaten</span>
            </div>
            <dl>
              <div><dt>Anliegen</dt><dd>Wasserhahn tropft, Küche</dd></div>
              <div><dt>Ort</dt><dd>68519 Viernheim</dd></div>
              <div><dt>Dringlichkeit</dt><dd>Normal, kein Notfall</dd></div>
              <div><dt>Fotos</dt><dd>1 Foto liegt vor</dd></div>
              <div><dt>Vorschlag</dt><dd>Termin Do., 8:00 Uhr</dd></div>
            </dl>
            <p class="uebersicht__frei"><Icon name="haken" /> Du entscheidest, ob der Termin passt.</p>
          </article>
          <article class="karte demo__echt" data-reveal style="--delay:.1s">
            <h3>Mit deinem Gewerk ausprobieren</h3>
            <p>Im Büro-Check zeigen wir dir die Live-Demo mit einer echten Anfrage aus deinem Gewerk. Du siehst sofort, was die KI antwortet.</p>
            <a href={CTA_LINK} class="btn btn--gelb btn--block-mobil">{CTA_TEXT} <Icon name="pfeil" /></a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Ablauf -->
  <section class="abschnitt abschnitt--dunkel" id="ablauf">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">So funktioniert's</p>
        <h2>Keine zusätzliche komplizierte Software. <span class="gelb">Ein Prozess, der zu dir passt.</span></h2>
      </div>
      <AblaufSchritte schritte={ABLAUF_KURZ} />
      <p class="mehr-link" data-reveal><a href="/ablauf" class="textlink">Genauer ansehen: So arbeiten wir</a></p>
    </div>
  </section>

  <!-- 6. Preise -->
  <section class="abschnitt abschnitt--tafel" id="preise">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Preise</p>
        <h2>Klare Pakete. <span class="gelb">Später erweiterbar.</span></h2>
        <p class="einleitung">Einmal einrichten, danach ein fester Betrag im Monat. Server, KI und Betreuung sind drin. Monatlich kündbar.</p>
      </div>
      <Pakete />
    </div>
  </section>

  <!-- 7. Rechner -->
  <section class="abschnitt abschnitt--dunkel" id="rechner">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Rechner</p>
        <h2>Was kosten dich verlorene Anfragen?</h2>
        <p class="einleitung">Drei Fragen, eine ehrliche Schätzung. Schieb die Regler auf die Zahlen aus deinem Betrieb.</p>
      </div>
      <div data-reveal>
        <Rechner />
      </div>
    </div>
  </section>

  <!-- 8. Vision und Gründer -->
  <section class="abschnitt abschnitt--tafel" id="vision">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Unsere Vision</p>
        <h2>Wir bauen Abora mit einer <span class="gelb">langfristigen Vision.</span></h2>
        <p class="einleitung">Abora wurde mit einem Ziel gestartet: Unternehmen von wiederkehrender Arbeit zu entlasten und intelligente Automatisierung zugänglich zu machen. Heute konzentrieren wir uns auf Handwerksbetriebe in Deutschland. Langfristig möchten wir daraus eine eigene Automatisierungsplattform für Unternehmen verschiedener Branchen entwickeln.</p>
      </div>
      <Vision />
      <div class="gruender" data-reveal>
        <div>
          <p class="mono">STAND HEUTE</p>
          <h3>Zwei Gründer. Noch keine Kunden. Ein klares Ziel.</h3>
          <p>Wir stehen am Anfang und suchen Betriebe, mit denen wir unsere Lösungen unter realen Bedingungen weiterentwickeln können.</p>
          <a href="/ueber-uns" class="textlink">Mehr über uns</a>
        </div>
        <ul class="gruender__zahlen">
          <li><strong>2</strong> Gründer</li>
          <li><strong>6</strong> Bausteine</li>
          <li><strong>3</strong> Pilotplätze</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 9. Pilotkunden-Angebot -->
  <section class="abschnitt abschnitt--dunkel" id="pilot">
    <div class="container pilot">
      <div data-reveal>
        <p class="dachzeile">Pilotbetriebe gesucht</p>
        <h2>Wir suchen die ersten 3 Handwerksbetriebe, mit denen wir gemeinsam starten.</h2>
        <p class="einleitung">
          Deshalb gibt es hier noch keine Kundenstimmen. Wir suchen Betriebe, die mit uns anfangen und uns ehrlich sagen, was
          funktioniert.
        </p>
      </div>
      <div class="karte pilot__karte" data-reveal style="--delay:.1s">
        <p class="pilot__label">Dein Vorteil als Pilotbetrieb</p>
        <p class="pilot__vorteil">{PILOTANGEBOT}</p>
        <a href={CTA_LINK} class="btn btn--gelb btn--block-mobil">{CTA_TEXT}</a>
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="abschnitt abschnitt--tafel" id="faq">
    <div class="container faq-raster">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Häufige Fragen</p>
        <h2>Was du wissen willst</h2>
        <p class="einleitung">Deine Frage ist nicht dabei? Stell sie uns im Büro-Check.</p>
      </div>
      <div data-reveal>
        <FAQ fragen={fragen} />
      </div>
    </div>
  </section>

  <!-- 11. Abschluss -->
  <Abschluss />
</Basis>

<style>
  .problem h3 {
    margin-bottom: 10px;
  }
  .problem p {
    margin: 0;
    color: var(--text-gedaempft);
  }
  .mehr-link {
    margin: 36px 0 0;
  }

  .demo {
    display: grid;
    gap: 28px;
  }
  .demo__seite {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  @media (min-width: 960px) {
    .demo {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 48px;
      align-items: start;
    }
  }
  .uebersicht__kopf {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .uebersicht__kopf h3 {
    margin: 0;
  }
  .uebersicht dl {
    margin: 0;
    display: grid;
  }
  .uebersicht dl div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px dashed var(--linie-dunkel);
  }
  .uebersicht dt {
    color: var(--text-gedaempft);
    font-size: 0.9rem;
  }
  .uebersicht dd {
    margin: 0;
    font-weight: 600;
  }
  .uebersicht__frei {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    color: var(--gelb);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .uebersicht__frei :global(svg) {
    width: 18px;
    height: 18px;
  }
  .demo__echt p {
    color: var(--text-gedaempft);
  }

  .gruender {
    margin-top: clamp(36px, 6vw, 64px);
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--linie-dunkel);
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .gruender {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
      gap: 56px;
    }
  }
  .gruender h3 {
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    margin: 10px 0 12px;
  }
  .gruender p {
    color: var(--text-gedaempft);
    max-width: 36rem;
  }
  .gruender__zahlen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-gedaempft);
  }
  .gruender__zahlen li {
    border: 1px solid var(--linie-dunkel);
    border-radius: 12px;
    padding: 16px 6px;
    background: var(--flaeche);
  }
  .gruender__zahlen strong {
    display: block;
    font-size: 2rem;
    line-height: 1.1;
    color: var(--gelb);
  }

  .pilot {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 960px) {
    .pilot {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 64px;
      align-items: center;
    }
  }
  .pilot h2 {
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
  }
  .pilot__karte {
    border-color: var(--gelb-linie);
    display: grid;
    gap: 18px;
  }
  .pilot__label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gelb);
  }
  .pilot__vorteil {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .faq-raster {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 960px) {
    .faq-raster {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: start;
    }
  }
</style>
