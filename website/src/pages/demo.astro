---
// Live-Demo für Erstgespräche: echte KI (Claude über n8n), erfundener Musterbetrieb.
// Nicht in Navigation und Sitemap, noindex, nur mit Demo-Code nutzbar.
import Basis from '../layouts/Basis.astro';
import Icon from '../components/Icon.astro';
import { DEMO_GEWERKE } from '../demo-gewerke';
import { DEMO_WEBHOOK_URL } from '../config';
---

<Basis
  titel="Live-Demo"
  beschreibung="Live-Demo von Abora Automation mit einem erfundenen Musterbetrieb."
  ohneLeiste
  noindex
  artikel
>
  <section class="demo" data-demo data-url={DEMO_WEBHOOK_URL}>
    <script type="application/json" id="demo-gewerke" set:html={JSON.stringify(DEMO_GEWERKE)} />

    <div class="container">
      <header class="demo-kopf">
        <div>
          <p class="dachzeile">Live-Demo</p>
          <h1>So läuft es in deinem Betrieb</h1>
          <p class="demo-hinweis">
            <span class="hinweis-beispiel">Demo</span>
            Der Betrieb ist erfunden, die KI antwortet echt. Bitte keine echten Kundendaten eingeben: Eingaben werden zur
            Beantwortung an Claude (Anthropic) übermittelt.
          </p>
        </div>
        <div class="demo-steuerung">
          <label class="feld-klein">
            <span>Gewerk</span>
            <select data-gewerk>
              {DEMO_GEWERKE.map((g) => <option value={g.key}>{g.name}</option>)}
            </select>
          </label>
          <button type="button" class="btn btn--rahmen btn--klein" data-neu>Neu starten</button>
        </div>
      </header>

      <div class="reiter" role="tablist" aria-label="Schritte der Demo">
        <button type="button" role="tab" id="reiter-1" aria-controls="schritt-1" aria-selected="true" data-reiter="1">
          <span>1</span> Anfrage
        </button>
        <button type="button" role="tab" id="reiter-2" aria-controls="schritt-2" aria-selected="false" data-reiter="2" tabindex="-1">
          <span>2</span> Angebot
        </button>
        <button type="button" role="tab" id="reiter-3" aria-controls="schritt-3" aria-selected="false" data-reiter="3" tabindex="-1">
          <span>3</span> Nachfassen<em class="reiter__zusatz">&nbsp;&amp; Bewertung</em>
        </button>
      </div>

      <!-- Schritt 1: Anfrage -->
      <div class="schritt" id="schritt-1" role="tabpanel" aria-labelledby="reiter-1" data-schritt="1">
        <div class="spalte">
          <div class="handy">
            <div class="handy__kopf">
              <span class="handy__avatar" aria-hidden="true">M</span>
              <div>
                <strong data-betrieb>Musterbetrieb</strong>
                <span class="handy__status" data-tippt-status>antwortet sofort</span>
              </div>
            </div>
            <ol class="verlauf" data-verlauf aria-live="polite" aria-label="Chatverlauf"></ol>
            <div class="vorschlaege" data-vorschlaege></div>
            <form class="eingabe" data-eingabe>
              <button type="button" class="eingabe__foto" data-foto aria-label="Beispielfoto als Kunde senden" title="Beispielfoto senden">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2"></rect><circle cx="12" cy="13" r="3.5"></circle><path d="M8 6l1.5-2h5L16 6"></path></svg>
              </button>
              <label class="sr-only" for="demo-nachricht">Nachricht als Kunde</label>
              <input id="demo-nachricht" type="text" autocomplete="off" maxlength="600" placeholder="Als Kunde schreiben …" data-nachricht />
              <button type="submit" class="eingabe__senden" aria-label="Senden">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20l18-8L3 4v6l12 2-12 2z"></path></svg>
              </button>
            </form>
          </div>
          <p class="unterschrift">Du schreibst als Kunde. Die KI antwortet im Namen des Betriebs.</p>
        </div>

        <div class="spalte">
          <h2 class="spalte__titel">Das siehst du als Chef</h2>
          <div class="meldungen" data-meldungen aria-live="polite"></div>
          <article class="karte-hell anfrage">
            <div class="anfrage__kopf">
              <h3>Anfrage</h3>
              <span class="dringlichkeit" data-dringlichkeit data-wert="unklar">noch unklar</span>
            </div>
            <dl class="felder">
              <div><dt>Kunde</dt><dd data-feld="kunde_name">–</dd></div>
              <div><dt>Ort</dt><dd data-feld="ort">–</dd></div>
              <div><dt>Anliegen</dt><dd data-feld="anliegen">–</dd></div>
              <div><dt>Umfang</dt><dd data-feld="umfang">–</dd></div>
              <div><dt>Zeitraum</dt><dd data-feld="zeitraum">–</dd></div>
              <div><dt>Budget</dt><dd data-feld="budget">–</dd></div>
              <div><dt>Foto</dt><dd data-feld="foto_erhalten">–</dd></div>
            </dl>
            <p class="zusammenfassung" data-zusammenfassung>Sobald ein Kunde schreibt, erscheint hier die Zusammenfassung.</p>
          </article>
          <article class="karte-hell kalender">
            <h3>Dein Kalender: freie Besichtigungstermine</h3>
            <ul class="termine" data-termine></ul>
          </article>
          <button type="button" class="btn btn--gelb" data-gehe="2">Weiter: Angebot erstellen <Icon name="pfeil" /></button>
        </div>
      </div>

      <!-- Schritt 2: Angebot -->
      <div class="schritt" id="schritt-2" role="tabpanel" aria-labelledby="reiter-2" data-schritt="2" hidden>
        <div class="spalte">
          <form class="karte-hell notiz" data-angebot-form>
            <h2 class="spalte__titel spalte__titel--dunkel">Sprachnotiz nach der Besichtigung</h2>
            <p class="klein">Im echten Einsatz sprichst du sie ins Handy. Hier steht sie abgetippt und lässt sich ändern.</p>
            <div class="zwei">
              <label class="feld-klein feld-klein--hell"><span>Kunde</span><input type="text" maxlength="100" data-angebot-kunde placeholder="z. B. Familie Schneider" /></label>
              <label class="feld-klein feld-klein--hell"><span>Ort</span><input type="text" maxlength="100" data-angebot-ort placeholder="z. B. Viernheim" /></label>
            </div>
            <label class="feld-klein feld-klein--hell">
              <span>Notiz</span>
              <textarea rows="8" maxlength="2000" data-notiz></textarea>
            </label>
            <button type="submit" class="btn btn--gelb" data-angebot-knopf>Angebot erstellen</button>
          </form>
        </div>
        <div class="spalte">
          <h2 class="spalte__titel">Angebotsentwurf zum Prüfen</h2>
          <article class="dokument" data-angebot aria-live="polite">
            <p class="leer">Hier erscheint der Angebotsentwurf.</p>
          </article>
          <button type="button" class="btn btn--gelb" data-gehe="3">Weiter: Nachfassen &amp; Bewertung <Icon name="pfeil" /></button>
        </div>
      </div>

      <!-- Schritt 3: Nachfassen & Bewertung -->
      <div class="schritt" id="schritt-3" role="tabpanel" aria-labelledby="reiter-3" data-schritt="3" hidden>
        <div class="schritt3-kopf">
          <p>Das Angebot ist raus. Was jetzt automatisch passiert, ohne dass du daran denken musst:</p>
          <button type="button" class="btn btn--gelb" data-nachfassen-knopf>Nachrichten erstellen</button>
        </div>
        <ol class="zeitstrahl" data-zeitstrahl aria-live="polite"></ol>
      </div>

      <p class="demo-fehler" data-fehler role="alert" hidden></p>
    </div>

    <!-- Demo-Code -->
    <div class="sperre" data-sperre hidden>
      <form class="sperre__karte" data-sperre-form>
        <h2>Demo-Code eingeben</h2>
        <p>Die Live-Demo ist für Erstgespräche gedacht und durch einen Code geschützt.</p>
        <label class="feld-klein feld-klein--hell">
          <span>Demo-Code</span>
          <input type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" data-code-eingabe required />
        </label>
        <p class="sperre__fehler" data-sperre-fehler hidden></p>
        <button type="submit" class="btn btn--gelb">Demo öffnen</button>
      </form>
    </div>
  </section>
</Basis>

<script>
  type Gewerk = { key: string; name: string; betrieb: string; beispiele: string[]; foto: string; notiz: string };
  type Nachricht = { rolle: 'kunde' | 'betrieb'; text: string; foto?: boolean };

  const wurzel = document.querySelector<HTMLElement>('[data-demo]')!;
  const URL_WEBHOOK = wurzel.dataset.url!;
  const GEWERKE: Gewerk[] = JSON.parse(document.getElementById('demo-gewerke')!.textContent || '[]');
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => wurzel.querySelector<T>(s)!;

  const speicher = {
    lesen(k: string) {
      try { return localStorage.getItem(k); } catch { return null; }
    },
    schreiben(k: string, v: string) {
      try { localStorage.setItem(k, v); } catch { /* egal */ }
    },
    loeschen(k: string) {
      try { localStorage.removeItem(k); } catch { /* egal */ }
    },
  };

  const euro = (n: number) => n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });

  // Freie Termine: die nächsten drei Werktage, je zwei Zeiten
  function freieTermine() {
    const tage = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
    const zeiten = [['7:30', '14:00'], ['9:00', '15:30'], ['8:00', '13:00']];
    const d = new Date();
    const liste: string[] = [];
    let i = 0;
    while (liste.length < 6) {
      d.setDate(d.getDate() + 1);
      const w = d.getDay();
      if (w === 0 || w === 6) continue;
      for (const z of zeiten[i % 3]) {
        liste.push(`${tage[w]}., ${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}., ${z} Uhr`);
      }
      i++;
    }
    return liste;
  }

  let zustand = neuerZustand();
  function neuerZustand() {
    return {
      verlauf: [] as Nachricht[],
      erfasst: {} as Record<string, unknown>,
      termine: freieTermine(),
      gebucht: '' as string,
      gemeldet: new Set<string>(),
      angebot: null as null | { titel: string; summe: string; kunde: string },
      laeuft: false,
    };
  }
  let code = speicher.lesen('abora-demo-code') || '';
  let gewerk: Gewerk = GEWERKE.find((g) => g.key === speicher.lesen('abora-demo-gewerk')) || GEWERKE[0];

  // ───────── Hilfen ─────────
  const fehlerBox = $('[data-fehler]');
  function zeigeFehler(text: string) {
    fehlerBox.textContent = text;
    fehlerBox.hidden = false;
  }
  function versteckeFehler() {
    fehlerBox.hidden = true;
  }

  async function frageKi(daten: Record<string, unknown>) {
    const antwort = await fetch(URL_WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...daten, code, gewerk: gewerk.key }),
    });
    if (!antwort.ok) throw new Error('Die Demo ist gerade nicht erreichbar (HTTP ' + antwort.status + ').');
    const j = await antwort.json();
    if (!j.ok) {
      if (/Demo-Code/.test(j.fehler || '')) {
        code = '';
        speicher.loeschen('abora-demo-code');
        sperreZeigen('Der Demo-Code stimmt nicht.');
      }
      throw new Error(j.fehler || 'Unbekannter Fehler.');
    }
    return j.daten;
  }

  function meldung(titel: string, text: string, art: '' | 'notfall' = '') {
    const box = $('[data-meldungen]');
    const el = document.createElement('div');
    el.className = 'meldung' + (art ? ' meldung--' + art : '');
    const icon = document.createElement('span');
    icon.className = 'meldung__icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.textContent = 'A';
    const inhalt = document.createElement('div');
    const kopf = document.createElement('div');
    kopf.className = 'meldung__zeile';
    kopf.innerHTML = '<span>Abora</span><span>jetzt</span>';
    const t = document.createElement('strong');
    t.textContent = titel;
    const p = document.createElement('span');
    p.className = 'meldung__text';
    p.textContent = text;
    inhalt.append(kopf, t, p);
    el.append(icon, inhalt);
    box.prepend(el);
    while (box.children.length > 3) box.lastElementChild!.remove();
  }

  // ───────── Schritt 1: Chat ─────────
  const verlaufEl = $('[data-verlauf]');
  const tippt = document.createElement('li');
  tippt.className = 'tippt';
  tippt.innerHTML = '<span></span><span></span><span></span>';
  tippt.setAttribute('aria-label', 'Die KI schreibt');

  function blase(n: Nachricht) {
    const li = document.createElement('li');
    li.className = 'blase blase--' + n.rolle;
    const wer = document.createElement('span');
    wer.className = 'sr-only';
    wer.textContent = n.rolle === 'kunde' ? 'Kunde:' : 'Betrieb (KI):';
    li.append(wer);
    if (n.foto) {
      const f = document.createElement('span');
      f.className = 'blase__foto';
      f.textContent = '📷 Foto';
      const cap = document.createElement('span');
      cap.className = 'blase__fotoinfo';
      cap.textContent = gewerk.foto;
      li.append(f, cap);
    } else {
      const t = document.createElement('span');
      t.textContent = n.text;
      li.append(t);
    }
    const zeit = document.createElement('span');
    zeit.className = 'blase__zeit';
    zeit.textContent = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) + (n.rolle === 'betrieb' ? ' ✓✓' : '');
    li.append(zeit);
    verlaufEl.append(li);
    verlaufEl.scrollTop = verlaufEl.scrollHeight;
  }

  function vorschlaegeZeigen() {
    const box = $('[data-vorschlaege]');
    box.replaceChildren();
    if (zustand.verlauf.length) return;
    for (const b of gewerk.beispiele) {
      const k = document.createElement('button');
      k.type = 'button';
      k.className = 'vorschlag';
      k.textContent = b;
      k.addEventListener('click', () => senden(b));
      box.append(k);
    }
  }

  function termineZeigen() {
    const ul = $('[data-termine]');
    ul.replaceChildren();
    for (const t of zustand.termine) {
      const li = document.createElement('li');
      li.textContent = t;
      const [, datum, zeit] = t.split(', ');
      if (zustand.gebucht && zustand.gebucht.includes(datum) && zustand.gebucht.includes(zeit.replace(' Uhr', ''))) li.className = 'gebucht';
      ul.append(li);
    }
  }

  function chefAnsicht(d: Record<string, any>) {
    for (const feld of ['kunde_name', 'ort', 'anliegen', 'umfang', 'zeitraum', 'budget']) {
      if (d[feld]) zustand.erfasst[feld] = d[feld];
      $(`[data-feld="${feld}"]`).textContent = (zustand.erfasst[feld] as string) || '–';
    }
    if (d.foto_erhalten) zustand.erfasst.foto_erhalten = true;
    $('[data-feld="foto_erhalten"]').textContent = zustand.erfasst.foto_erhalten ? 'erhalten ✓' : '–';
    const dr = $('[data-dringlichkeit]');
    const namen: Record<string, string> = { notfall: 'Notfall', hoch: 'dringend', normal: 'normal', niedrig: 'kann warten', unklar: 'noch unklar' };
    dr.dataset.wert = d.dringlichkeit;
    dr.textContent = namen[d.dringlichkeit] || 'noch unklar';
    if (d.zusammenfassung_fuer_chef) $('[data-zusammenfassung]').textContent = d.zusammenfassung_fuer_chef;
    if (d.gewaehlter_termin) zustand.gebucht = d.gewaehlter_termin;
    termineZeigen();

    // Benachrichtigungen, jeweils nur einmal
    const einmal = (k: string, f: () => void) => {
      if (!zustand.gemeldet.has(k)) {
        zustand.gemeldet.add(k);
        f();
      }
    };
    einmal('neu', () => meldung('Neue Anfrage', 'Automatisch beantwortet: ' + (d.anliegen || 'Kundenanfrage')));
    if (d.dringlichkeit === 'notfall' || d.status === 'notfall_weitergeleitet')
      einmal('notfall', () => meldung('Notfall – bitte zurückrufen', d.zusammenfassung_fuer_chef || 'Dringende Anfrage', 'notfall'));
    if (d.status === 'termin_gebucht' && d.gewaehlter_termin)
      einmal('termin', () => meldung('Termin gebucht', 'Besichtigung ' + d.gewaehlter_termin + (zustand.erfasst.kunde_name ? ' – ' + zustand.erfasst.kunde_name : '')));
    if (d.status === 'nicht_passend') einmal('passt', () => meldung('Anfrage passt nicht', 'Freundlich abgesagt, du musst nichts tun'));

    // Angebotsformular vorbefüllen
    const kundeFeld = $<HTMLInputElement>('[data-angebot-kunde]');
    const ortFeld = $<HTMLInputElement>('[data-angebot-ort]');
    if (!kundeFeld.value && zustand.erfasst.kunde_name) kundeFeld.value = zustand.erfasst.kunde_name as string;
    if (!ortFeld.value && zustand.erfasst.ort) ortFeld.value = zustand.erfasst.ort as string;
  }

  async function senden(text: string, foto = false) {
    if (zustand.laeuft) return;
    if (!code) return sperreZeigen();
    versteckeFehler();
    const n: Nachricht = { rolle: 'kunde', text: foto ? `[Foto: ${gewerk.foto}]` : text, foto };
    zustand.verlauf.push(n);
    blase(n);
    vorschlaegeZeigen();
    zustand.laeuft = true;
    verlaufEl.append(tippt);
    verlaufEl.scrollTop = verlaufEl.scrollHeight;
    $('[data-tippt-status]').textContent = 'schreibt …';
    try {
      const d = await frageKi({
        modus: 'chat',
        termine: zustand.termine,
        verlauf: zustand.verlauf.map((m) => ({ rolle: m.rolle, text: m.text })),
      });
      tippt.remove();
      const antwort: Nachricht = { rolle: 'betrieb', text: d.antwort };
      zustand.verlauf.push(antwort);
      blase(antwort);
      chefAnsicht(d);
    } catch (e) {
      tippt.remove();
      zustand.verlauf.pop(); // Kundennachricht zurücknehmen, damit der Verlauf abwechselt
      verlaufEl.lastElementChild?.remove();
      vorschlaegeZeigen();
      zeigeFehler((e as Error).message);
    } finally {
      zustand.laeuft = false;
      $('[data-tippt-status]').textContent = 'antwortet sofort';
    }
  }

  $<HTMLFormElement>('[data-eingabe]').addEventListener('submit', (e) => {
    e.preventDefault();
    const feld = $<HTMLInputElement>('[data-nachricht]');
    const t = feld.value.trim();
    if (!t) return;
    feld.value = '';
    senden(t);
  });
  $('[data-foto]').addEventListener('click', () => senden('', true));

  // ───────── Schritt 2: Angebot ─────────
  $<HTMLFormElement>('[data-angebot-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!code) return sperreZeigen();
    versteckeFehler();
    const knopf = $<HTMLButtonElement>('[data-angebot-knopf]');
    const doc = $('[data-angebot]');
    knopf.disabled = true;
    knopf.textContent = 'KI schreibt das Angebot …';
    doc.replaceChildren(Object.assign(document.createElement('p'), { className: 'leer', textContent: 'Die KI erstellt den Entwurf …' }));
    const kunde = $<HTMLInputElement>('[data-angebot-kunde]').value.trim();
    try {
      const d = await frageKi({
        modus: 'angebot',
        kunde,
        ort: $<HTMLInputElement>('[data-angebot-ort]').value.trim(),
        anliegen: (zustand.erfasst.anliegen as string) || '',
        notizen: $<HTMLTextAreaElement>('[data-notiz]').value,
      });
      angebotZeigen(d, kunde);
      meldung('Angebot vorbereitet', 'Entwurf aus deiner Sprachnotiz – bitte prüfen');
    } catch (err) {
      doc.replaceChildren(Object.assign(document.createElement('p'), { className: 'leer', textContent: 'Kein Entwurf.' }));
      zeigeFehler((err as Error).message);
    } finally {
      knopf.disabled = false;
      knopf.textContent = 'Angebot erstellen';
    }
  });

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, klasse = '', text = '') {
    const e = document.createElement(tag);
    if (klasse) e.className = klasse;
    if (text) e.textContent = text;
    return e;
  }

  function angebotZeigen(d: any, kunde: string) {
    const doc = $('[data-angebot]');
    doc.replaceChildren();
    const kopf = el('div', 'dokument__kopf');
    kopf.append(el('strong', '', gewerk.betrieb), el('span', 'hinweis-beispiel', 'Beispielpreise'));
    doc.append(kopf);
    doc.append(el('h3', '', d.titel));
    if (kunde) doc.append(el('p', 'dokument__kunde', 'Für: ' + kunde));
    doc.append(el('p', '', d.einleitung));

    const tabelle = el('table', 'positionen');
    const thead = el('thead');
    const kr = el('tr');
    for (const [t, k] of [['Pos.', ''], ['Leistung', ''], ['Menge', 'r'], ['Einzelpreis', 'r'], ['Gesamt', 'r']]) kr.append(el('th', k, t));
    thead.append(kr);
    const tbody = el('tbody');
    let netto = 0;
    (d.positionen || []).forEach((p: any, i: number) => {
      const summe = Math.round(Number(p.menge) * Number(p.einzelpreis_netto) * 100) / 100;
      netto += summe;
      const tr = el('tr');
      tr.append(
        el('td', '', String(i + 1)),
        el('td', '', p.bezeichnung),
        el('td', 'r', `${Number(p.menge).toLocaleString('de-DE')} ${p.einheit}`),
        el('td', 'r', euro(Number(p.einzelpreis_netto))),
        el('td', 'r', euro(summe)),
      );
      tbody.append(tr);
    });
    tabelle.append(thead, tbody);
    const huelle = el('div', 'tabelle-huelle');
    huelle.append(tabelle);
    doc.append(huelle);

    const mwst = Math.round(netto * 0.19 * 100) / 100;
    const brutto = netto + mwst;
    const summen = el('dl', 'summen');
    for (const [t, w, k] of [['Netto', euro(netto), ''], ['zzgl. 19 % MwSt.', euro(mwst), ''], ['Gesamt brutto', euro(brutto), 'gesamt']]) {
      const z = el('div', k);
      z.append(el('dt', '', t), el('dd', '', w));
      summen.append(z);
    }
    doc.append(summen);
    doc.append(el('p', 'klein', 'Beispielpreise der KI. Im echten Einsatz kommen die Preise aus deiner eigenen Preisliste.'));

    for (const [titel, liste] of [['Annahmen', d.annahmen], ['Rückfragen an den Kunden', d.rueckfragen]] as const) {
      if (!liste || !liste.length) continue;
      doc.append(el('h4', '', titel));
      const ul = el('ul');
      for (const t of liste) ul.append(el('li', '', t));
      doc.append(ul);
    }
    zustand.angebot = { titel: d.titel, summe: euro(brutto), kunde: kunde || (zustand.erfasst.kunde_name as string) || '' };
  }

  // ───────── Schritt 3: Nachfassen & Bewertung ─────────
  $('[data-nachfassen-knopf]').addEventListener('click', async () => {
    if (!code) return sperreZeigen();
    versteckeFehler();
    const knopf = $<HTMLButtonElement>('[data-nachfassen-knopf]');
    const ol = $('[data-zeitstrahl]');
    knopf.disabled = true;
    knopf.textContent = 'KI schreibt …';
    try {
      const a = zustand.angebot;
      const d = await frageKi({
        modus: 'nachfassen',
        kunde: a?.kunde || (zustand.erfasst.kunde_name as string) || $<HTMLInputElement>('[data-angebot-kunde]').value || '',
        titel: a?.titel || (zustand.erfasst.anliegen as string) || gewerk.name,
        summe: a?.summe || '',
      });
      ol.replaceChildren();
      const punkt = (wann: string, titel: string, text?: string, kanal?: string, art = '') => {
        const li = el('li', 'zeit' + (art ? ' zeit--' + art : ''));
        li.append(el('span', 'zeit__wann', wann));
        const box = el('div', 'zeit__inhalt');
        box.append(el('strong', '', titel + (kanal ? ' · ' + kanal : '')));
        if (text) box.append(el('p', 'zeit__text', text));
        li.append(box);
        ol.append(li);
      };
      punkt('Tag 0', 'Angebot verschickt', a ? `${a.titel} (${a.summe})` : undefined);
      for (const n of d.nachfassen || []) punkt('Tag ' + n.tag, 'Nachfassen', n.text, n.kanal);
      punkt('', 'Kunde sagt zu', 'Der Auftrag landet in deinem Kalender.', '', 'erfolg');
      punkt('Nach dem Auftrag', 'Rechnung verschickt', 'Automatisch, sobald du den Auftrag als erledigt markierst.');
      punkt('+14 Tage', 'Zahlungserinnerung (nur falls offen)', d.zahlungserinnerung);
      punkt('Danach', 'Bitte um Bewertung', d.bewertungsanfrage);
      meldung('Angebot angenommen ✓', (a?.kunde ? a.kunde + ' hat ' : 'Der Kunde hat ') + 'nach der Erinnerung zugesagt');
    } catch (e) {
      zeigeFehler((e as Error).message);
    } finally {
      knopf.disabled = false;
      knopf.textContent = 'Nachrichten neu erstellen';
    }
  });

  // ───────── Reiter ─────────
  const reiter = Array.from(wurzel.querySelectorAll<HTMLButtonElement>('[data-reiter]'));
  function zeigeSchritt(n: string) {
    for (const r of reiter) {
      const aktiv = r.dataset.reiter === n;
      r.setAttribute('aria-selected', String(aktiv));
      r.tabIndex = aktiv ? 0 : -1;
    }
    wurzel.querySelectorAll<HTMLElement>('[data-schritt]').forEach((s) => (s.hidden = s.dataset.schritt !== n));
    versteckeFehler();
  }
  reiter.forEach((r, i) => {
    r.addEventListener('click', () => zeigeSchritt(r.dataset.reiter!));
    r.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const ziel = reiter[(i + (e.key === 'ArrowRight' ? 1 : reiter.length - 1)) % reiter.length];
      ziel.focus();
      zeigeSchritt(ziel.dataset.reiter!);
    });
  });
  wurzel.querySelectorAll<HTMLElement>('[data-gehe]').forEach((b) =>
    b.addEventListener('click', () => {
      zeigeSchritt(b.dataset.gehe!);
      $('.reiter').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  // ───────── Gewerk & Neustart ─────────
  function neuStarten() {
    zustand = neuerZustand();
    verlaufEl.replaceChildren();
    $('[data-meldungen]').replaceChildren();
    for (const f of ['kunde_name', 'ort', 'anliegen', 'umfang', 'zeitraum', 'budget', 'foto_erhalten']) $(`[data-feld="${f}"]`).textContent = '–';
    const dr = $('[data-dringlichkeit]');
    dr.dataset.wert = 'unklar';
    dr.textContent = 'noch unklar';
    $('[data-zusammenfassung]').textContent = 'Sobald ein Kunde schreibt, erscheint hier die Zusammenfassung.';
    $('[data-betrieb]').textContent = gewerk.betrieb;
    $<HTMLTextAreaElement>('[data-notiz]').value = gewerk.notiz;
    $<HTMLInputElement>('[data-angebot-kunde]').value = '';
    $<HTMLInputElement>('[data-angebot-ort]').value = '';
    $('[data-angebot]').replaceChildren(Object.assign(document.createElement('p'), { className: 'leer', textContent: 'Hier erscheint der Angebotsentwurf.' }));
    $('[data-zeitstrahl]').replaceChildren();
    $('[data-nachfassen-knopf]').textContent = 'Nachrichten erstellen';
    vorschlaegeZeigen();
    termineZeigen();
    versteckeFehler();
    zeigeSchritt('1');
  }
  const auswahl = $<HTMLSelectElement>('[data-gewerk]');
  auswahl.value = gewerk.key;
  auswahl.addEventListener('change', () => {
    gewerk = GEWERKE.find((g) => g.key === auswahl.value) || GEWERKE[0];
    speicher.schreiben('abora-demo-gewerk', gewerk.key);
    neuStarten();
  });
  $('[data-neu]').addEventListener('click', neuStarten);

  // ───────── Demo-Code ─────────
  const sperre = $('[data-sperre]');
  function sperreZeigen(fehler = '') {
    sperre.hidden = false;
    const f = $('[data-sperre-fehler]');
    f.textContent = fehler;
    f.hidden = !fehler;
    $<HTMLInputElement>('[data-code-eingabe]').focus();
  }
  $<HTMLFormElement>('[data-sperre-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    code = $<HTMLInputElement>('[data-code-eingabe]').value.trim().toUpperCase();
    if (!code) return;
    speicher.schreiben('abora-demo-code', code);
    sperre.hidden = true;
  });

  neuStarten();
  if (!code) sperreZeigen();
</script>

