---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import FAQ from '../components/FAQ.astro';
import Abschluss from '../components/Abschluss.astro';
import Icon from '../components/Icon.astro';
import Pakete from '../components/Pakete.astro';
import { PREISE, CTA_LINK, CTA_TEXT } from '../config';

const fragen = [
  {
    frage: 'Warum einmal Aufbau und dann monatlich?',
    antwort:
      '<p>Der Aufbau ist die eigentliche Arbeit: Wir richten alles für deinen Betrieb ein und testen es. Danach muss es laufen, überwacht und gelegentlich angepasst werden. Außerdem fallen jeden Monat Kosten für Server und KI an. Die sind in der monatlichen Betreuung schon drin.</p>',
  },
  {
    frage: 'Gibt es versteckte Kosten?',
    antwort:
      '<p>Nein. Server- und KI-Kosten sind in der Betreuung enthalten. Wenn du später zusätzliche Bausteine willst, bekommst du vorher einen festen Preis.</p>',
  },
  {
    frage: 'Kann ich mit „Start“ anfangen und später erweitern?',
    antwort:
      '<p>Ja, genau dafür ist das Paket gedacht. Du fängst mit Anfragen und Vorsortieren an und nimmst später weitere Bausteine dazu.</p>',
  },
  {
    frage: 'Wie lange läuft der Vertrag?',
    antwort: '<p>Die Betreuung ist monatlich kündbar.</p>',
  },
  {
    frage: 'Lohnt sich das für meinen kleinen Betrieb?',
    antwort:
      '<p>Rechne es dir mit unserem <a href="/#rechner">Rechner auf der Startseite</a> mit deinen eigenen Zahlen aus. Im Erstgespräch sagen wir dir ehrlich, ob es sich für dich lohnt, auch wenn die Antwort „noch nicht“ ist.</p>',
  },
];
---

<Basis
  titel="Preise"
  beschreibung="Preise von Abora Automation: einmaliger Aufbau plus monatliche Betreuung. Pakete Start, Business und Komplett für Handwerksbetriebe, Server- und KI-Kosten inklusive."
>
  <Seitenkopf
    dachzeile="Preise"
    titel='Einmal aufbauen. <span class="gelb">Dauerhaft entlastet.</span>'
    text="Du zahlst einmal für den Aufbau und danach einen festen Betrag im Monat. Server, KI, Betreuung und Anpassungen sind drin."
  />

  <section class="abschnitt abschnitt--tafel">
    <div class="container">
      <div class="modell" data-reveal>
        <div class="modell__teil">
          <span class="modell__icon"><Icon name="werkzeug" /></span>
          <div>
            <h2 class="modell__titel">Aufbau <small>einmalig</small></h2>
            <p>Analyse im Erstgespräch, Einrichtung der vereinbarten Bausteine, Anbindung an das, was du schon nutzt, Testphase, Einweisung.</p>
          </div>
        </div>
        <span class="modell__plus" aria-hidden="true">+</span>
        <div class="modell__teil">
          <span class="modell__icon"><Icon name="schild" /></span>
          <div>
            <h2 class="modell__titel">Betreuung <small>monatlich</small></h2>
            <p>Laufender Betrieb und Überwachung, Anpassungen, Support, Server- und KI-Kosten, monatlicher Kurzbericht.</p>
          </div>
        </div>
      </div>

      <Pakete />
    </div>
  </section>

  <section class="abschnitt abschnitt--tafel abschnitt--faq">
    <div class="container">
      <div class="kopf" data-reveal>
        <p class="dachzeile">Fragen zu Kosten</p>
        <h2>Was du über die Preise wissen willst</h2>
      </div>
      <FAQ fragen={fragen} />
    </div>
  </section>

  <Abschluss
    titel='Was kostet es <span class="gelb">bei dir</span>?'
    text="Im kostenlosen Erstgespräch schauen wir, welche Bausteine sich für deinen Betrieb lohnen. Danach bekommst du einen festen Preis."
  />
</Basis>

<style>
  .modell {
    display: grid;
    gap: 16px;
    align-items: center;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  @media (min-width: 900px) {
    .modell {
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
    }
  }
  .modell__teil {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    background: var(--flaeche);
    border: 1px solid var(--linie-hell);
    border-radius: var(--radius-gross);
    padding: 24px;
    height: 100%;
  }
  .modell__teil p {
    margin: 0;
    color: var(--text-gedaempft-hell);
  }
  .modell__icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--dunkel);
    color: var(--gelb);
    display: grid;
    place-items: center;
  }
  .modell__icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  .modell__titel {
    font-size: 1.6rem;
    margin-bottom: 8px;
  }
  .modell__titel small {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gelb);
    margin-left: 6px;
  }
  .modell__plus {
    justify-self: center;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    color: var(--gelb);
  }

  .pakete {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .pakete {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  .paket {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--flaeche);
    border: 1px solid var(--linie-hell);
    border-radius: var(--radius-gross);
    padding: 30px 24px;
  }
  .paket--hervor {
    background: var(--dunkel);
    color: var(--text-hell);
    border: 2px solid var(--gelb);
  }
  .paket__fuer {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gelb);
  }
  .paket--hervor .paket__fuer {
    color: var(--gelb);
  }
  .paket__name {
    font-size: 2.4rem;
    margin: 0;
    letter-spacing: -0.04em;
  }
  .paket__text {
    margin: 0;
    color: var(--text-gedaempft-hell);
  }
  .paket--hervor .paket__text {
    color: var(--text-gedaempft);
  }
  .paket__preis {
    display: grid;
    gap: 8px;
    justify-items: start;
    padding: 16px 0;
    border-block: 1px solid var(--linie-hell);
  }
  .paket--hervor .paket__preis {
    border-color: var(--linie-dunkel);
  }
  .paket__preis p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .paket__betrag:first-child {
    font-size: 1.7rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em;
  }
  .paket ul {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .paket li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .paket li :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    color: var(--text-gedaempft);
  }
  .paket--hervor li :global(svg) {
    color: var(--gelb);
  }
  .paket--hervor .btn--rahmen {
    color: var(--text-hell);
  }
  .preis-hinweis {
    margin: 24px 0 0;
    font-size: 0.9rem;
    color: var(--text-gedaempft-hell);
  }
  .abschnitt--faq {
    padding-top: 0;
  }
</style>
